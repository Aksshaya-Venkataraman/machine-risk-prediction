# Copy-free setup: run `python scripts/generate_env.py` to create .env with
# random secrets. This file only documents the variables - it holds no values.

# Public hostname served by Caddy (use "localhost" for a local HTTPS test).
DOMAIN=localhost
# Browser origins allowed to call the API, comma-separated (empty = no CORS).
CORS_ORIGINS=

# PostgreSQL: superuser (container only) and the app's least-privilege role.
POSTGRES_SUPERUSER_PASSWORD=
APP_DB_USER=machine_risk
APP_DB_PASSWORD=
APP_DB_NAME=machine_risk

REDIS_PASSWORD=

# >= 32 random characters each.
JWT_SECRET_KEY=
INTERNAL_API_TOKEN=
MODEL_ADMIN_TOKEN=
